@startuml FloatingPointStateMachine
title Floating Point Detector State Diagram

state "StartState" as Start
state "LeadingZeroState" as LeadingZero
state "IntegerPartState" as IntPart
state "NeedFractionDigitState" as NeedFrac
state "FractionPartState" as FracPart
state "Accept" as Accept
state "Reject" as Reject

[*] --> Start

Start --> LeadingZero : [0]
Start --> IntPart : [1-9]
Start --> NeedFrac : [.]
Start --> Reject : [other]
Start --> Reject : [end]

LeadingZero --> NeedFrac : [.]
LeadingZero --> Reject : [other]
LeadingZero --> Reject : [end]

IntPart --> IntPart : [0-9]
IntPart --> NeedFrac : [.]
IntPart --> Reject : [other]
IntPart --> Reject : [end]

NeedFrac --> FracPart : [0-9]
NeedFrac --> Reject : [.]
NeedFrac --> Reject : [other]
NeedFrac --> Reject : [end]

FracPart --> FracPart : [0-9]
FracPart --> Reject : [.]
FracPart --> Reject : [other]
FracPart --> Accept : [end]

Accept --> [*]
Reject --> [*]
@enduml

