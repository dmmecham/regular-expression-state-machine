@startuml BinaryOnesStateMachine
title Binary (Starts and Ends With 1) State Diagram

state "StartState" as Start
state "LastWasOneState" as LastOne
state "LastWasZeroState" as LastZero
state "Accept" as Accept
state "Reject" as Reject

[*] --> Start

Start --> LastOne : [1]
Start --> Reject : [0]
Start --> Reject : [other]
Start --> Reject : [end]

LastOne --> LastOne : [1]
LastOne --> LastZero : [0]
LastOne --> Reject : [other]
LastOne --> Accept : [end]

LastZero --> LastOne : [1]
LastZero --> LastZero : [0]
LastZero --> Reject : [other]
LastZero --> Reject : [end]

Accept --> [*]
Reject --> [*]
@enduml
