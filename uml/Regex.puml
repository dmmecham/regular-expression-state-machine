@startuml RegexProgram
title Regex Detector Program UML (State Pattern)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "state.regex" {
	interface Detector {
		+detect(input: String): Boolean
	}

	interface State {
		+handle(context: ContextDetector, token: String): void
		+onEnd(context: ContextDetector): void
	}

	abstract class ContextDetector {
		-tokens: List<String>
		-index: Int
		-terminal: Boolean
		-accepted: Boolean
		#currentState: State
		+detect(input: String): Boolean
		+nextToken(): String?
		+transitionTo(state: State): void
		+reject(): void
		+accept(): void
		#createInitialState(): State
		#beforeDetection(): void
		#afterInputConsumed(): void
		-splitToSingleCharacterTokens(input: String): List<String>
	}

	object TokenRules {
		+isDigit(token: String): Boolean
		+isNonZeroDigit(token: String): Boolean
		+isBinaryDigit(token: String): Boolean
		+isUppercase(token: String): Boolean
		+isSpecial(token: String): Boolean
		+isSpace(token: String): Boolean
	}

	class IntegerDetector
	class FloatingPointDetector
	class BinaryOnesDetector
	class EmailAddressDetector
	class PasswordDetector {
		#createInitialState(): State
	}

	Detector <|.. ContextDetector
	ContextDetector o--> State : currentState
	ContextDetector <|-- IntegerDetector
	ContextDetector <|-- FloatingPointDetector
	ContextDetector <|-- BinaryOnesDetector
	ContextDetector <|-- EmailAddressDetector
	ContextDetector <|-- PasswordDetector

	IntegerDetector ..> TokenRules
	FloatingPointDetector ..> TokenRules
	BinaryOnesDetector ..> TokenRules
	EmailAddressDetector ..> TokenRules
	PasswordDetector ..> TokenRules

	class "IntegerDetector.StartState" as IntegerStartState <<inner>>
	class "IntegerDetector.DigitsState" as IntegerDigitsState <<inner>>
	abstract class "IntegerDetector.IntegerState" as IntegerStateBase <<inner>>
	State <|.. IntegerStateBase
	IntegerStateBase <|-- IntegerStartState
	IntegerStateBase <|-- IntegerDigitsState
	IntegerDetector *-- IntegerStartState
	IntegerDetector *-- IntegerDigitsState
	IntegerDetector *-- IntegerStateBase

	class "FloatingPointDetector.StartState" as FloatStartState <<inner>>
	class "FloatingPointDetector.LeadingZeroState" as FloatLeadingZeroState <<inner>>
	class "FloatingPointDetector.IntegerPartState" as FloatIntegerPartState <<inner>>
	class "FloatingPointDetector.NeedFractionDigitState" as FloatNeedFractionState <<inner>>
	class "FloatingPointDetector.FractionPartState" as FloatFractionPartState <<inner>>
	abstract class "FloatingPointDetector.FloatingPointState" as FloatingPointStateBase <<inner>>
	State <|.. FloatingPointStateBase
	FloatingPointStateBase <|-- FloatStartState
	FloatingPointStateBase <|-- FloatLeadingZeroState
	FloatingPointStateBase <|-- FloatIntegerPartState
	FloatingPointStateBase <|-- FloatNeedFractionState
	FloatingPointStateBase <|-- FloatFractionPartState
	FloatingPointDetector *-- FloatStartState
	FloatingPointDetector *-- FloatLeadingZeroState
	FloatingPointDetector *-- FloatIntegerPartState
	FloatingPointDetector *-- FloatNeedFractionState
	FloatingPointDetector *-- FloatFractionPartState
	FloatingPointDetector *-- FloatingPointStateBase

	class "BinaryOnesDetector.StartState" as BinaryStartState <<inner>>
	class "BinaryOnesDetector.LastWasOneState" as BinaryLastWasOneState <<inner>>
	class "BinaryOnesDetector.LastWasZeroState" as BinaryLastWasZeroState <<inner>>
	abstract class "BinaryOnesDetector.BinaryOnesState" as BinaryOnesStateBase <<inner>>
	State <|.. BinaryOnesStateBase
	BinaryOnesStateBase <|-- BinaryStartState
	BinaryOnesStateBase <|-- BinaryLastWasOneState
	BinaryOnesStateBase <|-- BinaryLastWasZeroState
	BinaryOnesDetector *-- BinaryStartState
	BinaryOnesDetector *-- BinaryLastWasOneState
	BinaryOnesDetector *-- BinaryLastWasZeroState
	BinaryOnesDetector *-- BinaryOnesStateBase

	class "EmailAddressDetector.StartState" as EmailStartState <<inner>>
	class "EmailAddressDetector.Part1State" as EmailPart1State <<inner>>
	class "EmailAddressDetector.NeedPart2State" as EmailNeedPart2State <<inner>>
	class "EmailAddressDetector.Part2State" as EmailPart2State <<inner>>
	class "EmailAddressDetector.NeedPart3State" as EmailNeedPart3State <<inner>>
	class "EmailAddressDetector.Part3State" as EmailPart3State <<inner>>
	abstract class "EmailAddressDetector.EmailAddressState" as EmailAddressStateBase <<inner>>
	State <|.. EmailAddressStateBase
	EmailAddressStateBase <|-- EmailStartState
	EmailAddressStateBase <|-- EmailPart1State
	EmailAddressStateBase <|-- EmailNeedPart2State
	EmailAddressStateBase <|-- EmailPart2State
	EmailAddressStateBase <|-- EmailNeedPart3State
	EmailAddressStateBase <|-- EmailPart3State
	EmailAddressDetector *-- EmailStartState
	EmailAddressDetector *-- EmailPart1State
	EmailAddressDetector *-- EmailNeedPart2State
	EmailAddressDetector *-- EmailPart2State
	EmailAddressDetector *-- EmailNeedPart3State
	EmailAddressDetector *-- EmailPart3State
	EmailAddressDetector *-- EmailAddressStateBase

	class "PasswordDetector.CollectingState" as PasswordCollectingState <<inner>>
	class "PasswordDetector.ValidatingState" as PasswordValidatingState <<inner>>
	abstract class "PasswordDetector.PasswordState" as PasswordStateBase <<inner>>
	State <|.. PasswordStateBase
	PasswordStateBase <|-- PasswordCollectingState
	PasswordStateBase <|-- PasswordValidatingState
	PasswordDetector *-- PasswordCollectingState
	PasswordDetector *-- PasswordValidatingState
	PasswordDetector *-- PasswordStateBase
}

note bottom of ContextDetector
Input is split into one-character String tokens.
Each state handles one token at a time.
end note

note right of ContextDetector
detect(input) is the template method.
createInitialState(), beforeDetection(), and afterInputConsumed() are the hooks.
end note

@enduml
